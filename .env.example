# Copy this file to .env and fill in the values. .env is gitignored; never commit it.

# ---- Embeddings (OpenAI) -- used to embed questions at query time. Must be
# the same model the index was built with (checked against manifest.json).

# Required: API key for the hosted embedding endpoint (an OpenAI key from
# https://platform.openai.com/api-keys unless EMBEDDING_BASE_URL says otherwise).
EMBEDDING_API_KEY=

# Required: the embedding model name, exactly as the API expects it
# (e.g. "text-embedding-3-small"). There is no default — the build will
# stop and ask rather than guess this.
EMBEDDING_MODEL=

# Optional: only needed if the endpoint isn't the default OpenAI API
# (e.g. a self-hosted or proxied OpenAI-compatible endpoint).
EMBEDDING_BASE_URL=

# Optional: used to compute an estimated cost in manifest.json. If unset,
# manifests still record total tokens embedded, just not a dollar figure.
EMBEDDING_COST_PER_1M_TOKENS=

# Optional: where to reach Qdrant. Defaults to the local docker-compose
# service if unset.
QDRANT_URL=http://localhost:6333

# Optional: overrides the reranker model (default: cross-encoder/ms-marco-MiniLM-L-6-v2,
# chosen over BAAI/bge-reranker-base for latency -- see docs/design.md's
# Retrieval section). Set to BAAI/bge-reranker-base for the higher-recall,
# much-slower Week-8 comparison point.
RERANKER_MODEL=

# Optional: overrides the reranker's max token length (default: 384,
# tuned -- see docs/design.md). Only change this if re-measuring the
# latency/recall trade yourself.
RERANKER_MAX_LENGTH=

# ---- Answer generation (Google Gemini) -- src/generation/. Embeddings
# above stay on OpenAI; Gemini only writes the answer.

# Required for generation: get one at https://aistudio.google.com/apikey.
GEMINI_API_KEY=

# Optional: the Gemini model id (default: gemini-flash-latest, an alias that
# follows Google's current Flash model). Pin an exact id from
# https://ai.google.dev/gemini-api/docs/models for reproducible eval runs.
GEMINI_MODEL=

# Optional: sampling temperature. Leave unset to use the model's default,
# which Google recommends for Gemini 3+ models.
GEMINI_TEMPERATURE=

# ---- HTTP API (src/api/main.py) -- read once at startup.

# Answer generator. Default "openai" (gpt-4o-mini), using OPENAI_API_KEY if
# set, else EMBEDDING_API_KEY -- so the service needs only the one OpenAI key
# above. "gemini" uses src/generation/gemini.py instead (needs GEMINI_API_KEY
# below); it took 100-300s per answer with our key.
GENERATOR=
# Optional (default: gpt-4o-mini).
OPENAI_GENERATION_MODEL=

# Optional: "false" skips the cross-encoder reranker (faster, lower
# recall@5). Default: true.
LIBRARIAN_RERANK=

# Optional: a different built index directory (outside Docker; the container
# builds and uses the default). Default: data/index/heading_mt512_min20.
LIBRARIAN_INDEX_DIR=

# Optional: where requests.jsonl / feedback.jsonl are appended (gitignored).
# Default: data/logs.
LOG_DIR=
